# Firebase web app config
VITE_FIREBASE_API_KEY="your_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# Firebase App Check (reCAPTCHA v3 site key)
VITE_RECAPTCHA_SITE_KEY="your_recaptcha_site_key"
# Optional: a fixed debug token for local dev. Generate a UUID, put it here,
# and register it in Firebase Console -> App Check -> Manage debug tokens.
# Leave unset to have the SDK auto-generate one and print it to the console.
VITE_APPCHECK_DEBUG_TOKEN=""

# OpenAI lives server-side in Firebase Functions.
# See functions/.env.example for the OPENAI_API_KEY variable.
